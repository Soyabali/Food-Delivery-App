# Copy to backend/.env and fill in. Never commit .env (it is git-ignored).

# PostgreSQL connection: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
# (URL-encode special characters in the password, e.g. @ -> %40)
DATABASE_URL=postgresql+psycopg://apna_food_app:change-me@localhost:5432/apna_food

# Web dashboard origins allowed to call the API (comma-separated).
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Public URL of this server, used to build uploaded image URLs.
# For the Android emulator use the LAN IP of your PC, e.g. http://192.168.1.20:8000
PUBLIC_BASE_URL=http://localhost:8000
MEDIA_DIR=media
MAX_UPLOAD_MB=5

# Sign-in sessions (days).
SESSION_DAYS=30

# Password reset: 6-digit code emailed to the user.
PASSWORD_RESET_MINUTES=15
PASSWORD_RESET_MAX_ATTEMPTS=5
PASSWORD_RESET_RESEND_SECONDS=45

# Outgoing email (SMTP). Leave SMTP_HOST empty to print emails in the server
# log instead (development). Gmail: create an App Password at
# https://myaccount.google.com/apppasswords (needs 2-Step Verification) and
# use it as SMTP_PASSWORD - never your normal Gmail password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Cart rules (rupees / percent).
STANDARD_DELIVERY_FEE=30
FREE_DELIVERY_THRESHOLD=199
TAX_RATE_PERCENT=5

# Fallback point for restaurant distances (Bengaluru city centre).
DEFAULT_LATITUDE=12.9716
DEFAULT_LONGITUDE=77.5946

# Used only by scripts/seed.py to create the first admin account.
ADMIN_EMAIL=admin@apnafood.com
ADMIN_PASSWORD=change-this-admin-password
