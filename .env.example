# Apna Food build configuration (public values only).
#
# Copy to `.env`, then run:
#   flutter run --dart-define-from-file=.env
# Values are compiled into the app. Never put secrets or private API keys here:
# anything in a mobile app binary can be extracted.

# Food/recipe provider (real HTTP).
FOOD_API_BASE_URL=https://dummyjson.com

# mock = on-device mock backend (default, no server needed)
# http = send backend requests to BACKEND_BASE_URL
BACKEND_MODE=mock

# Your backend (used only when BACKEND_MODE=http).
# Android emulator -> your PC's localhost is 10.0.2.2.
BACKEND_BASE_URL=http://10.0.2.2:3000/api

# Network timeout per request, in seconds.
API_TIMEOUT_SECONDS=15

# Simulated latency of the mock backend, in milliseconds (0 = instant).
MOCK_LATENCY_MS=600
